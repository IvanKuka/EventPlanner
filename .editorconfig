root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,axaml,xml,resx,plist,iss}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Result<T>.Success/Failure factories are the intended API of the result type.
dotnet_diagnostic.CA1000.severity = none
# Structured logging is used directly; LoggerMessage source generation is an optimization for hot paths only.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Desktop app has no synchronization context requirements in services; ConfigureAwait noise is not useful here.
dotnet_diagnostic.CA2007.severity = none
# Product UI is Slovak-only for now; string comparison cultures are chosen explicitly where it matters.
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
# UI messages are formatted once per user action; caching CompositeFormat per message adds noise without measurable benefit.
dotnet_diagnostic.CA1863.severity = none
# xUnit test method names use underscores.
dotnet_diagnostic.CA1707.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
