<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EventPlanner.Desktop.ViewModels.Budget"
             xmlns:l="using:EventPlanner.Desktop.Localization"
             x:Class="EventPlanner.Desktop.Views.BudgetView"
             x:DataType="vm:BudgetViewModel">

  <Panel>
    <StackPanel IsVisible="{Binding !HasProject}">
      <TextBlock Classes="h1" Text="{x:Static l:Strings.Nav_Budget}" />
      <TextBlock Classes="muted" Text="{x:Static l:Strings.Common_SelectProjectFirst}" />
    </StackPanel>

    <DockPanel IsVisible="{Binding HasProject}">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Classes="h1" Text="{x:Static l:Strings.Nav_Budget}" />
        <Border Classes="message warning" IsVisible="{Binding IsReadOnly}">
          <TextBlock Text="{x:Static l:Strings.Events_ArchivedReadOnly}" TextWrapping="Wrap" />
        </Border>

        <!-- Totals in the project currency: three kinds of amounts kept apart. -->
        <ContentControl Content="{Binding ProjectTotals}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:BudgetTotalsView">
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static l:Strings.Budget_Estimated}" />
                    <TextBlock Grid.Column="0" Grid.Row="1" FontSize="18" Text="{Binding EstimatedText}" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{x:Static l:Strings.Budget_Committed}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" FontSize="18" Text="{Binding CommittedText}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{x:Static l:Strings.Budget_Paid}" />
                    <TextBlock Grid.Column="2" Grid.Row="1" FontSize="18" Text="{Binding PaidText}" />
                    <TextBlock Grid.Column="3" Classes="muted" Text="{x:Static l:Strings.Budget_RemainingTitle}" />
                    <TextBlock Grid.Column="3" Grid.Row="1" FontSize="18" FontWeight="SemiBold" Text="{Binding RemainingText}" />
                    <TextBlock Grid.Column="4" Classes="muted" Text="{x:Static l:Strings.Budget_OverpaidTitle}" />
                    <TextBlock Grid.Column="4" Grid.Row="1" FontSize="18" Text="{Binding OverpaidText}" />
                  </Grid>
                  <TextBlock Classes="muted" FontSize="12">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{x:Static l:Strings.Budget_TotalsDetail}">
                        <Binding Path="RefundedText" />
                        <Binding Path="ScheduledText" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Classes="notice" Text="{x:Static l:Strings.Budget_OverpaidHint}" IsVisible="{Binding HasOverpaid}" TextWrapping="Wrap" />
                  <TextBlock Classes="notice" Text="{Binding MissingText}" TextWrapping="Wrap"
                             IsVisible="{Binding MissingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Other currencies are never converted or added to the project totals. -->
        <ItemsControl ItemsSource="{Binding OtherCurrencyTotals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BudgetTotalsView">
              <Border Classes="message warning">
                <TextBlock TextWrapping="Wrap">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{x:Static l:Strings.Budget_OtherCurrencyTotals}">
                      <Binding Path="Currency" />
                      <Binding Path="CommittedText" />
                      <Binding Path="PaidText" />
                      <Binding Path="RemainingText" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,12,400">
        <!-- Items -->
        <DockPanel Grid.Column="0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{x:Static l:Strings.Budget_ItemsTitle}" />
            <Button Grid.Column="1" Classes="accent" Content="{x:Static l:Strings.Budget_NewItem}" Command="{Binding NewItemCommand}" IsEnabled="{Binding !IsReadOnly}" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{x:Static l:Strings.Budget_NoItems}" IsVisible="{Binding !Items.Count}" Margin="0,8" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="{x:Static l:Strings.Budget_ItemsTitle}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BudgetItemRow">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="2,3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Category}" />
                    <TextBlock Text="{x:Static l:Strings.Budget_QuoteBadge}" Opacity="0.7" IsVisible="{Binding HasQuote}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding BalanceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,12,0" Text="{Binding EstimatedText, StringFormat={x:Static l:Strings.Budget_EstimatedShort}}" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,12,0" Text="{Binding CommittedText, StringFormat={x:Static l:Strings.Budget_CommittedShort}}" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,12,0" Text="{Binding PaidText, StringFormat={x:Static l:Strings.Budget_PaidShort}}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ScheduledText}" IsVisible="{Binding ScheduledText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </WrapPanel>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="notice" Text="{Binding ForeignCurrencyText}"
                             IsVisible="{Binding ForeignCurrencyText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Detail -->
        <ScrollViewer Grid.Column="2">
          <StackPanel>
            <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message warning" IsVisible="{Binding WarningMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message info" IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="muted" Text="{x:Static l:Strings.Budget_SelectHint}" IsVisible="{Binding !IsEditingItem}" TextWrapping="Wrap" />

            <Border Classes="card" IsVisible="{Binding IsEditingItem}">
              <StackPanel IsEnabled="{Binding !IsReadOnly}">
                <TextBlock Classes="h2" Text="{x:Static l:Strings.Budget_ItemDetail}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_Title}" />
                <TextBox Text="{Binding ItemTitle}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Budget_Title}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Title]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Vendors_Category}" />
                <TextBox Text="{Binding ItemCategory}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Vendors_Category}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Category]}" />
                <Grid ColumnDefinitions="*,8,*,8,80">
                  <StackPanel>
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_Estimated}" />
                    <TextBox Text="{Binding ItemEstimated}" AutomationProperties.Name="{x:Static l:Strings.Budget_Estimated}" />
                    <TextBlock Classes="field-error" Text="{Binding Errors[EstimatedMinor]}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_Committed}" />
                    <TextBox Text="{Binding ItemCommitted}" AutomationProperties.Name="{x:Static l:Strings.Budget_Committed}" />
                    <TextBlock Classes="field-error" Text="{Binding Errors[CommittedMinor]}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Common_Currency}" />
                    <TextBox Text="{Binding ItemCurrency}" MaxLength="3" IsEnabled="{Binding IsNewItem}" AutomationProperties.Name="{x:Static l:Strings.Common_Currency}" />
                    <TextBlock Classes="field-error" Text="{Binding Errors[Currency]}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Budget_AmountsHint}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ItemBalanceText}" FontWeight="SemiBold" Margin="0,6,0,0"
                           IsVisible="{Binding ItemBalanceText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Id]}" />
                <StackPanel Classes="buttons">
                  <Button Classes="accent" Content="{x:Static l:Strings.Common_Save}" Command="{Binding SaveItemCommand}" />
                  <Button Content="{x:Static l:Strings.Common_Delete}" Command="{Binding RequestDeleteItemCommand}">
                    <Button.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsNewItem" />
                        <Binding Path="!IsConfirmingDelete" />
                      </MultiBinding>
                    </Button.IsVisible>
                  </Button>
                </StackPanel>
                <Border Classes="message warning" IsVisible="{Binding IsConfirmingDelete}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static l:Strings.Budget_ConfirmDelete}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{x:Static l:Strings.Common_YesDelete}" Command="{Binding ConfirmDeleteItemCommand}" />
                      <Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelDeleteItemCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Payments of the item -->
                <StackPanel IsVisible="{Binding !IsNewItem}" Margin="0,12,0,0">
                  <TextBlock Classes="h2" Text="{x:Static l:Strings.Budget_PaymentsTitle}" />
                  <TextBlock Classes="muted" Text="{x:Static l:Strings.Budget_NoPayments}" IsVisible="{Binding !Payments.Count}" />
                  <ListBox ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" MaxHeight="220"
                           AutomationProperties.Name="{x:Static l:Strings.Budget_PaymentsTitle}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PaymentRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="2,2">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" Opacity="0.8" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding AmountText}" HorizontalAlignment="Right" />
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding DateText}" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Reference}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel IsVisible="{Binding CanChangeSelectedPayment}" Spacing="6" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanPostSelectedPayment}">
                      <CalendarDatePicker SelectedDate="{Binding PostDate}" AutomationProperties.Name="{x:Static l:Strings.Budget_PaidDate}" />
                      <Button Content="{x:Static l:Strings.Budget_MarkPaid}" Command="{Binding PostSelectedPaymentCommand}" />
                    </StackPanel>
                    <Button Content="{x:Static l:Strings.Budget_CancelPayment}" Command="{Binding CancelSelectedPaymentCommand}" />
                  </StackPanel>

                  <TextBlock Classes="h2" Text="{x:Static l:Strings.Budget_NewPayment}" />
                  <Grid ColumnDefinitions="*,8,*">
                    <StackPanel>
                      <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_PaymentKind}" />
                      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding NewPaymentKind}"
                                AutomationProperties.Name="{x:Static l:Strings.Budget_PaymentKind}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_PaymentStatus}" />
                      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding NewPaymentStatus}"
                                AutomationProperties.Name="{x:Static l:Strings.Budget_PaymentStatus}" />
                      <TextBlock Classes="field-error" Text="{Binding Errors[Status]}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Vendors_Amount}" />
                  <TextBox Text="{Binding PaymentAmount}" AutomationProperties.Name="{x:Static l:Strings.Vendors_Amount}" />
                  <TextBlock Classes="field-error" Text="{Binding Errors[AmountMinor]}" />
                  <StackPanel IsVisible="{Binding IsPostedPayment}">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_PaidDate}" />
                    <CalendarDatePicker SelectedDate="{Binding PaymentPaidDate}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:Strings.Budget_PaidDate}" />
                    <TextBlock Classes="field-error" Text="{Binding Errors[PaidLocalDate]}" />
                  </StackPanel>
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_DueDate}" />
                  <CalendarDatePicker SelectedDate="{Binding PaymentDueDate}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:Strings.Budget_DueDate}" />
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Budget_Reference}" />
                  <TextBox Text="{Binding PaymentReference}" MaxLength="200" AutomationProperties.Name="{x:Static l:Strings.Budget_Reference}" />
                  <TextBlock Classes="field-error" Text="{Binding Errors[Reference]}" />
                  <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Budget_PaymentHint}" TextWrapping="Wrap" />
                  <Button Margin="0,6,0,0" Classes="accent" Content="{x:Static l:Strings.Budget_RecordPayment}" Command="{Binding RecordPaymentCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Panel>
</UserControl>
