<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EventPlanner.Desktop.ViewModels.Guests"
             xmlns:contracts="using:EventPlanner.Contracts.Guests"
             xmlns:l="using:EventPlanner.Desktop.Localization"
             xmlns:views="using:EventPlanner.Desktop.Views"
             x:Class="EventPlanner.Desktop.Views.GuestsView"
             x:DataType="vm:GuestsViewModel">

  <Panel>
    <StackPanel IsVisible="{Binding !HasProject}">
      <TextBlock Classes="h1" Text="{x:Static l:Strings.Nav_Guests}" />
      <TextBlock Classes="muted" Text="{x:Static l:Strings.Common_SelectProjectFirst}" />
    </StackPanel>

    <DockPanel IsVisible="{Binding HasProject}">
      <Border DockPanel.Dock="Top" Classes="ribbon">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding !IsReadOnly}">
            <StackPanel Classes="ribbon-group">
              <TextBlock Classes="ribbon-caption" Text="{x:Static l:Strings.Ribbon_Guests}" />
              <StackPanel Orientation="Horizontal">
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.GuestAdd}" Content="{x:Static l:Strings.Guests_NewGuest}" Command="{Binding NewGuestCommand}" />
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Delete}" Content="{x:Static l:Strings.Ribbon_DeleteGuest}" Command="{Binding RequestDeleteGuestCommand}"
                        IsEnabled="{Binding SelectedGuest, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </StackPanel>
            <Border Classes="ribbon-divider" />
            <StackPanel Classes="ribbon-group">
              <TextBlock Classes="ribbon-caption" Text="{x:Static l:Strings.Ribbon_Groups}" />
              <StackPanel Orientation="Horizontal">
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Guests}" Content="{x:Static l:Strings.Guests_NewGroup}" Command="{Binding NewGroupCommand}" />
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Delete}" Content="{x:Static l:Strings.Ribbon_DeleteGroup}" Command="{Binding RequestDeleteGroupCommand}" ToolTip.Tip="{x:Static l:Strings.Guests_DeleteGroup}"
                        IsEnabled="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Counts per program part -->
      <StackPanel DockPanel.Dock="Top">
        <Border Classes="message warning" IsVisible="{Binding IsReadOnly}">
          <TextBlock Text="{x:Static l:Strings.Events_ArchivedReadOnly}" TextWrapping="Wrap" />
        </Border>
        <ItemsControl ItemsSource="{Binding Counts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="contracts:ProgramPartCountsDto">
              <Border Classes="card" Margin="0,0,8,8" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Accepted, StringFormat={x:Static l:Strings.Guests_CountAccepted}}" />
                  <TextBlock Text="{Binding Tentative, StringFormat={x:Static l:Strings.Guests_CountTentative}}" Opacity="0.8" />
                  <TextBlock Text="{Binding Declined, StringFormat={x:Static l:Strings.Guests_CountDeclined}}" Opacity="0.8" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" Text="{Binding UnassignedText}" IsVisible="{Binding UnassignedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <Grid ColumnDefinitions="190,12,*,12,340">
        <!-- Groups -->
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{x:Static l:Strings.Guests_Groups}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{x:Static l:Strings.Guests_NoGroups}" IsVisible="{Binding !Groups.Count}" />
          <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                   AutomationProperties.Name="{x:Static l:Strings.Guests_Groups}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="contracts:GroupDto">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="2,4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Guest list -->
        <DockPanel Grid.Column="2">
          <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBox Text="{Binding SearchText}" PlaceholderText="{x:Static l:Strings.Guests_SearchWatermark}"
                     AutomationProperties.Name="{x:Static l:Strings.Guests_SearchWatermark}" />
            <!-- Filters wrap onto a second row in a narrow window instead of clipping their text. -->
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <ComboBox MinWidth="148" ItemsSource="{Binding RsvpFilterOptions}" SelectedItem="{Binding RsvpFilter}"
                        AutomationProperties.Name="{x:Static l:Strings.Guests_FilterRsvp}" />
              <ComboBox MinWidth="148" ItemsSource="{Binding PartFilterOptions}" SelectedItem="{Binding PartFilter}"
                        AutomationProperties.Name="{x:Static l:Strings.Guests_FilterPart}" />
              <ComboBox MinWidth="148" ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding GroupFilter}"
                        AutomationProperties.Name="{x:Static l:Strings.Guests_FilterGroup}" />
            </WrapPanel>
            <TextBlock Classes="muted" FontSize="12" Text="{Binding ListSummary}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{x:Static l:Strings.Guests_Empty}" IsVisible="{Binding !Guests.Count}" Margin="0,8" />
          <!-- ListBox virtualizes its items, which keeps large guest lists responsive. -->
          <ListBox ItemsSource="{Binding Guests}" SelectedItem="{Binding SelectedGuest}" AutomationProperties.Name="{x:Static l:Strings.Nav_Guests}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GuestRow">
                <Grid ColumnDefinitions="*,Auto" Margin="2,3">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{x:Static l:Strings.Guests_PlaceholderBadge}" Opacity="0.7" IsVisible="{Binding IsPlaceholder}" />
                      <TextBlock Text="{x:Static l:Strings.Guests_NoteBadge}" Opacity="0.7" IsVisible="{Binding HasPrivateNote}" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding PartsLabel}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RsvpLabel}" HorizontalAlignment="Right" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding GroupLabel}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Detail -->
        <ScrollViewer Grid.Column="4">
          <StackPanel>
            <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message warning" IsVisible="{Binding WarningMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message info" IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Classes="muted" Text="{x:Static l:Strings.Guests_SelectHint}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsEditingGuest" />
                  <Binding Path="!IsEditingGroup" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>

            <!-- Guest editor -->
            <Border Classes="card" IsVisible="{Binding IsEditingGuest}">
              <StackPanel IsEnabled="{Binding !IsReadOnly}">
                <TextBlock Classes="h2" Text="{x:Static l:Strings.Guests_GuestDetail}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_Name}" />
                <TextBox Text="{Binding EditName}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Guests_Name}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[DisplayName]}" />

                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_Kind}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding EditKind}"
                          AutomationProperties.Name="{x:Static l:Strings.Guests_Kind}" />

                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_Rsvp}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RsvpOptions}" SelectedItem="{Binding EditRsvp}"
                          AutomationProperties.Name="{x:Static l:Strings.Guests_Rsvp}" />

                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_Group}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding EditGroup}"
                          AutomationProperties.Name="{x:Static l:Strings.Guests_Group}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[GroupId]}" />

                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_AgeCategory}" />
                <TextBox Text="{Binding EditAgeCategory}" AutomationProperties.Name="{x:Static l:Strings.Guests_AgeCategory}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[AgeCategory]}" />

                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_ProgramParts}" />
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Guests_NoProgramParts}" IsVisible="{Binding !PartChoices.Count}" />
                <ItemsControl ItemsSource="{Binding PartChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Choice">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="field-error" Text="{Binding Errors[ProgramPartIds]}" />

                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_PrivateNote}" />
                <Button views:ButtonIcon.Data="{StaticResource Icon.Reveal}" Content="{x:Static l:Strings.Guests_RevealNote}" Command="{Binding RevealPrivateNoteCommand}" IsVisible="{Binding !IsPrivateNoteRevealed}" />
                <TextBox Text="{Binding EditPrivateNote}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                         IsVisible="{Binding IsPrivateNoteRevealed}" AutomationProperties.Name="{x:Static l:Strings.Guests_PrivateNote}" />
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Guests_PrivateNoteHint}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[PrivateNote]}" />

                <StackPanel Classes="buttons">
                  <Button views:ButtonIcon.Data="{StaticResource Icon.Save}" Classes="accent" Content="{x:Static l:Strings.Common_Save}" Command="{Binding SaveGuestCommand}" />
                </StackPanel>
                <Border Classes="message warning" IsVisible="{Binding IsConfirmingDelete}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static l:Strings.Guests_ConfirmDelete}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{x:Static l:Strings.Common_YesDelete}" Command="{Binding ConfirmDeleteGuestCommand}" />
                      <Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelDeleteGuestCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Group editor and group RSVP -->
            <Border Classes="card" IsVisible="{Binding IsEditingGroup}">
              <StackPanel IsEnabled="{Binding !IsReadOnly}">
                <TextBlock Classes="h2" Text="{x:Static l:Strings.Guests_GroupDetail}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_GroupLabel}" />
                <TextBox Text="{Binding GroupLabel}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Guests_GroupLabel}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Label]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_ContactName}" />
                <TextBox Text="{Binding GroupContactName}" AutomationProperties.Name="{x:Static l:Strings.Guests_ContactName}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[ContactName]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_ContactEmail}" />
                <TextBox Text="{Binding GroupContactEmail}" AutomationProperties.Name="{x:Static l:Strings.Guests_ContactEmail}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[ContactEmail]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_Phone}" />
                <TextBox Text="{Binding GroupPhone}" AutomationProperties.Name="{x:Static l:Strings.Guests_Phone}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Phone]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Guests_GroupNotes}" />
                <TextBox Text="{Binding GroupNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                         AutomationProperties.Name="{x:Static l:Strings.Guests_GroupNotes}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Notes]}" />
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Guests_ContactHint}" />
                <StackPanel Classes="buttons">
                  <Button views:ButtonIcon.Data="{StaticResource Icon.Save}" Classes="accent" Content="{x:Static l:Strings.Common_Save}" Command="{Binding SaveGroupCommand}" />
                </StackPanel>
                <Border Classes="message warning" IsVisible="{Binding IsConfirmingGroupDelete}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static l:Strings.Guests_ConfirmDeleteGroup}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="danger" Content="{x:Static l:Strings.Common_YesDelete}" Command="{Binding DeleteGroupCommand}" />
                      <Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelDeleteGroupCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding !!GroupMembers.Count}">
                  <TextBlock Classes="h2" Text="{x:Static l:Strings.Guests_GroupRsvpTitle}" />
                  <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Guests_GroupRsvpHint}" />
                  <ComboBox HorizontalAlignment="Stretch" Margin="0,6" ItemsSource="{Binding RsvpOptions}" SelectedItem="{Binding GroupRsvpState}"
                            AutomationProperties.Name="{x:Static l:Strings.Guests_Rsvp}" />
                  <ItemsControl ItemsSource="{Binding GroupMembers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:Choice">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Margin="0,6,0,0" Content="{x:Static l:Strings.Guests_ApplyGroupRsvp}" Command="{Binding ApplyGroupRsvpCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Panel>
</UserControl>
