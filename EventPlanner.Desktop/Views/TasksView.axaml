<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EventPlanner.Desktop.ViewModels.Tasks"
             xmlns:l="using:EventPlanner.Desktop.Localization"
             xmlns:views="using:EventPlanner.Desktop.Views"
             x:Class="EventPlanner.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel">

  <Panel>
    <StackPanel IsVisible="{Binding !HasProject}">
      <TextBlock Classes="h1" Text="{x:Static l:Strings.Nav_Tasks}" />
      <TextBlock Classes="muted" Text="{x:Static l:Strings.Common_SelectProjectFirst}" />
    </StackPanel>

    <DockPanel IsVisible="{Binding HasProject}">
      <Border DockPanel.Dock="Top" Classes="ribbon">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding !IsReadOnly}">
            <StackPanel Classes="ribbon-group">
              <TextBlock Classes="ribbon-caption" Text="{x:Static l:Strings.Ribbon_Tasks}" />
              <StackPanel Orientation="Horizontal">
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Add}" Content="{x:Static l:Strings.Tasks_New}" Command="{Binding NewTaskCommand}" />
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Delete}" Content="{x:Static l:Strings.Ribbon_DeleteTask}" Command="{Binding RequestDeleteCommand}"
                        IsEnabled="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </StackPanel>
            <Border Classes="ribbon-divider" />
            <StackPanel Classes="ribbon-group">
              <TextBlock Classes="ribbon-caption" Text="{x:Static l:Strings.Ribbon_TaskState}" />
              <StackPanel Orientation="Horizontal">
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Import}" Content="{x:Static l:Strings.Tasks_MarkInProgress}" Command="{Binding MarkInProgressCommand}"
                        IsEnabled="{Binding CanChangeState}" />
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Select}" Content="{x:Static l:Strings.Tasks_MarkDone}" Command="{Binding MarkDoneCommand}"
                        IsEnabled="{Binding CanChangeState}" />
                <Button Classes="command" views:ButtonIcon.Data="{StaticResource Icon.Close}" Content="{x:Static l:Strings.Tasks_Reopen}" Command="{Binding MarkTodoCommand}"
                        IsEnabled="{Binding CanChangeState}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border DockPanel.Dock="Top" Classes="message warning" IsVisible="{Binding IsReadOnly}">
        <TextBlock Text="{x:Static l:Strings.Events_ArchivedReadOnly}" TextWrapping="Wrap" />
      </Border>

      <Grid ColumnDefinitions="*,12,360">
        <!-- To-do list -->
        <DockPanel Grid.Column="0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Classes="muted" Text="{Binding SummaryText}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="{x:Static l:Strings.Tasks_ShowDone}" IsChecked="{Binding ShowDone}" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{x:Static l:Strings.Tasks_Empty}" IsVisible="{Binding !Tasks.Count}" Margin="0,8" TextWrapping="Wrap" />
          <!-- ListBox virtualizes its items, so long task lists stay responsive. -->
          <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="{x:Static l:Strings.Nav_Tasks}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskRow">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="2,3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsDone}"
                               TextDecorations="{Binding IsDone, Converter={x:Static views:StrikeThroughConverter.Instance}}" />
                    <Border Classes="pill" IsVisible="{Binding IsHighPriority}" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static l:Strings.Tasks_HighPriority}" />
                    </Border>
                  </StackPanel>
                  <!-- State chip: colour plus text, so the state never depends on colour alone. -->
                  <Border Grid.Column="1" Classes="pill" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Classes.positive="{Binding IsDone}" Classes.notice="{Binding IsInProgress}" Classes.neutral="{Binding IsTodo}">
                    <TextBlock Text="{Binding StateText}" />
                  </Border>
                  <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,12,0" Text="{Binding DueText}" />
                    <TextBlock Classes="notice" FontSize="12" Margin="0,0,12,0" Text="{x:Static l:Strings.Tasks_Overdue}" IsVisible="{Binding IsOverdue}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,12,0" Text="{Binding OwnerText}"
                               IsVisible="{Binding OwnerText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding WaitingText}"
                               IsVisible="{Binding WaitingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </WrapPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Detail -->
        <ScrollViewer Grid.Column="2">
          <StackPanel>
            <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message warning" IsVisible="{Binding WarningMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message info" IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="muted" Text="{x:Static l:Strings.Tasks_SelectHint}" IsVisible="{Binding !IsEditing}" />

            <Border Classes="card" IsVisible="{Binding IsEditing}">
              <StackPanel IsEnabled="{Binding !IsReadOnly}">
                <TextBlock Classes="h2" Text="{x:Static l:Strings.Tasks_Detail}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Tasks_Title}" />
                <TextBox Text="{Binding EditTitle}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Tasks_Title}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Title]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Tasks_OwnerLabel}" />
                <TextBox Text="{Binding EditOwner}" MaxLength="120" AutomationProperties.Name="{x:Static l:Strings.Tasks_OwnerLabel}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[OwnerLabel]}" />
                <Grid ColumnDefinitions="*,8,*">
                  <StackPanel>
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Tasks_DueLabel}" />
                    <CalendarDatePicker SelectedDate="{Binding EditDue}" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Static l:Strings.Tasks_DueLabel}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Tasks_Priority}" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding EditPriority}"
                              AutomationProperties.Name="{x:Static l:Strings.Tasks_Priority}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Tasks_DeadlineHint}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Tasks_Predecessor}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PredecessorOptions}" SelectedItem="{Binding EditPredecessor}"
                          AutomationProperties.Name="{x:Static l:Strings.Tasks_Predecessor}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[PredecessorId]}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Tasks_Notes}" />
                <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="2000"
                         AutomationProperties.Name="{x:Static l:Strings.Tasks_Notes}" />
                <TextBlock Classes="field-error" Text="{Binding Errors[Notes]}" />
                <StackPanel Classes="buttons">
                  <Button views:ButtonIcon.Data="{StaticResource Icon.Save}" Classes="accent" Content="{x:Static l:Strings.Common_Save}" Command="{Binding SaveTaskCommand}" />
                </StackPanel>
                <Border Classes="message warning" IsVisible="{Binding IsConfirmingDelete}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static l:Strings.Tasks_ConfirmDelete}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="danger" Content="{x:Static l:Strings.Common_YesDelete}" Command="{Binding ConfirmDeleteCommand}" />
                      <Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelDeleteCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Panel>
</UserControl>
