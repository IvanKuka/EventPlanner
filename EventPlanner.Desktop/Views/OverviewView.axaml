<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:EventPlanner.Desktop.ViewModels.Overview"
             xmlns:guests="using:EventPlanner.Contracts.Guests"
             xmlns:tasks="using:EventPlanner.Desktop.ViewModels.Tasks"
             xmlns:l="using:EventPlanner.Desktop.Localization"
             x:Class="EventPlanner.Desktop.Views.OverviewView"
             x:DataType="overview:OverviewViewModel">
  <ScrollViewer>
    <StackPanel>
      <TextBlock Classes="h1" Text="{x:Static l:Strings.Nav_Overview}" IsVisible="{Binding !HasProject}" />
      <TextBlock Classes="muted" Text="{x:Static l:Strings.Common_SelectProjectFirst}" IsVisible="{Binding !HasProject}" />

      <StackPanel IsVisible="{Binding HasProject}">
        <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Name, status and venue are in the shell's project bar; the date line adds the time zone. -->
        <TextBlock Classes="muted" Text="{Binding DateText}" Margin="0,0,0,10" />

        <!-- Key figures -->
        <Grid ColumnDefinitions="*,12,*">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <StackPanel Classes="icon-text">
                <Path Classes="icon" Data="{StaticResource Icon.Guests}" Stroke="{DynamicResource AppMutedBrush}" />
                <TextBlock Classes="label" Margin="0" Text="{x:Static l:Strings.Nav_Guests}" />
              </StackPanel>
              <TextBlock Text="{Binding TotalGuestsText}" FontSize="16" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <StackPanel Spacing="4">
              <StackPanel Classes="icon-text">
                <Path Classes="icon" Data="{StaticResource Icon.Budget}" Stroke="{DynamicResource AppMutedBrush}" />
                <TextBlock Classes="label" Margin="0" Text="{x:Static l:Strings.Nav_Budget}" />
              </StackPanel>
              <TextBlock Text="{Binding BudgetText}" FontSize="16" TextWrapping="Wrap"
                         IsVisible="{Binding BudgetText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted" Text="{x:Static l:Strings.Budget_NoItems}" TextWrapping="Wrap"
                         IsVisible="{Binding BudgetText, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="3*,16,2*">
          <!-- Counts per program part -->
          <StackPanel>
            <TextBlock Classes="h2" Text="{x:Static l:Strings.Overview_CountsTitle}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding PartCounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="guests:ProgramPartCountsDto">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,76,76,120,76" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{x:Static l:Strings.Rsvp_Accepted}" />
                      <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Accepted}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentTextBrush}" />
                      <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{x:Static l:Strings.Rsvp_Tentative}" />
                      <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Tentative}" FontSize="20" />
                      <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="{x:Static l:Strings.Overview_AwaitingAnswer}" />
                      <TextBlock Grid.Column="3" Grid.Row="1" FontSize="20">
                        <TextBlock.Text>
                          <MultiBinding StringFormat="{}{0} / {1}">
                            <Binding Path="Unknown" />
                            <Binding Path="Invited" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                      <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="{x:Static l:Strings.Rsvp_Declined}" />
                      <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding Declined}" FontSize="20" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Overview_CountsHint}" />
          </StackPanel>

          <!-- Upcoming tasks and open issues -->
          <StackPanel Grid.Column="2">
            <TextBlock Classes="h2" Text="{x:Static l:Strings.Overview_TasksTitle}" Margin="0,0,0,6" />
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="{x:Static l:Strings.Overview_NoTasks}" IsVisible="{Binding !UpcomingTasks.Count}" />
                <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="tasks:TaskRow">
                      <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <WrapPanel>
                          <TextBlock Classes="muted" FontSize="12" Margin="0,0,10,0" Text="{Binding DueText}" />
                          <TextBlock Classes="notice" FontSize="12" Margin="0,0,10,0" FontWeight="SemiBold" Text="{x:Static l:Strings.Tasks_Overdue}" IsVisible="{Binding IsOverdue}" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding OwnerText}" IsVisible="{Binding OwnerText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </WrapPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Classes="h2" Text="{x:Static l:Strings.Overview_IssuesTitle}" Margin="0,0,0,6" />
            <Border Classes="card" IsVisible="{Binding !Issues.Count}">
              <StackPanel Classes="icon-text">
                <Path Classes="icon" Data="{StaticResource Icon.Select}" Stroke="{DynamicResource StatusPositiveBrush}" />
                <TextBlock Classes="muted" Text="{x:Static l:Strings.Overview_NoIssues}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Issues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="message warning">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
