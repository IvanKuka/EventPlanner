<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:EventPlanner.Desktop.ViewModels.Overview"
             xmlns:guests="using:EventPlanner.Contracts.Guests"
             xmlns:l="using:EventPlanner.Desktop.Localization"
             x:Class="EventPlanner.Desktop.Views.OverviewView"
             x:DataType="overview:OverviewViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="{x:Static l:Strings.Nav_Overview}" IsVisible="{Binding !HasProject}" />
      <TextBlock Classes="muted" Text="{x:Static l:Strings.Common_SelectProjectFirst}" IsVisible="{Binding !HasProject}" />

      <StackPanel IsVisible="{Binding HasProject}">
        <TextBlock Classes="h1" Text="{Binding Heading}" />
        <Border Classes="message error" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding DateText}" />
            <TextBlock Text="{Binding VenueText}" IsVisible="{Binding VenueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TotalGuestsText}" />
            <TextBlock Text="{Binding BudgetText}" IsVisible="{Binding BudgetText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock Classes="h2" Text="{x:Static l:Strings.Overview_CountsTitle}" />
        <ItemsControl ItemsSource="{Binding PartCounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="guests:ProgramPartCountsDto">
              <Border Classes="card">
                <Grid ColumnDefinitions="2*,90,90,150,90" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.RowSpan="2" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{x:Static l:Strings.Rsvp_Accepted}" />
                  <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Accepted}" FontSize="18" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{x:Static l:Strings.Rsvp_Tentative}" />
                  <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Tentative}" FontSize="18" />
                  <TextBlock Grid.Column="3" Classes="muted" Text="{x:Static l:Strings.Overview_AwaitingAnswer}" />
                  <TextBlock Grid.Column="3" Grid.Row="1" FontSize="18">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} / {1}">
                        <Binding Path="Unknown" />
                        <Binding Path="Invited" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="4" Classes="muted" Text="{x:Static l:Strings.Rsvp_Declined}" />
                  <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding Declined}" FontSize="18" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" FontSize="12" Text="{x:Static l:Strings.Overview_CountsHint}" />

        <TextBlock Classes="h2" Text="{x:Static l:Strings.Overview_IssuesTitle}" />
        <TextBlock Classes="muted" Text="{x:Static l:Strings.Overview_NoIssues}" IsVisible="{Binding !Issues.Count}" />
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="message warning">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
