<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:events="using:EventPlanner.Desktop.ViewModels.Events"
             xmlns:overview="using:EventPlanner.Desktop.ViewModels.Overview"
             xmlns:guests="using:EventPlanner.Desktop.ViewModels.Guests"
             xmlns:vendors="using:EventPlanner.Desktop.ViewModels.Vendors"
             xmlns:budget="using:EventPlanner.Desktop.ViewModels.Budget"
             xmlns:backup="using:EventPlanner.Desktop.ViewModels.Backup"
             xmlns:views="using:EventPlanner.Desktop.Views"
             x:Class="EventPlanner.Desktop.App"
             RequestedThemeVariant="Default">

  <!-- Explicit view mapping (no reflection-based view locator). -->
  <Application.DataTemplates>
    <DataTemplate DataType="events:EventsViewModel">
      <views:EventsView />
    </DataTemplate>
    <DataTemplate DataType="overview:OverviewViewModel">
      <views:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="guests:GuestsViewModel">
      <views:GuestsView />
    </DataTemplate>
    <DataTemplate DataType="vendors:VendorsViewModel">
      <views:VendorsView />
    </DataTemplate>
    <DataTemplate DataType="budget:BudgetViewModel">
      <views:BudgetView />
    </DataTemplate>
    <DataTemplate DataType="backup:BackupViewModel">
      <views:BackupView />
    </DataTemplate>
  </Application.DataTemplates>

  <!-- App palette: neutral grey/white surfaces with one rose accent (same layout language as the
       sibling AdobeNew app, own accent so the two apps are not confused). Light text colours keep
       >= 4.5:1 contrast on white; status colours are own brushes because Fluent's
       SystemFillColor*Brush did not resolve in the light variant (verified by StatusColorTests). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EventPlanner/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#1F2937" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#6B7280" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E7EB" />
          <SolidColorBrush x:Key="AppControlBorderBrush" Color="#D1D5DB" />
          <SolidColorBrush x:Key="AppHoverBrush" Color="#F3F4F6" />
          <SolidColorBrush x:Key="AppSelectionBrush" Color="#FCE7F3" />
          <SolidColorBrush x:Key="AppDisabledSurfaceBrush" Color="#F9FAFB" />
          <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#9CA3AF" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#BE185D" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#9D174D" />
          <SolidColorBrush x:Key="AppAccentDisabledBrush" Color="#F9A8D4" />
          <SolidColorBrush x:Key="AppAccentTextBrush" Color="#BE185D" />
          <SolidColorBrush x:Key="MessageErrorBrush" Color="#FEF2F2" />
          <SolidColorBrush x:Key="MessageWarningBrush" Color="#FFFBEB" />
          <SolidColorBrush x:Key="MessageInfoBrush" Color="#ECFDF5" />
          <SolidColorBrush x:Key="MessageErrorBorderBrush" Color="#FECACA" />
          <SolidColorBrush x:Key="MessageWarningBorderBrush" Color="#FDE68A" />
          <SolidColorBrush x:Key="MessageInfoBorderBrush" Color="#A7F3D0" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="StatusNoticeBrush" Color="#8A4B00" />
          <SolidColorBrush x:Key="StatusPositiveBrush" Color="#1E7A46" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#141B25" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#202936" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#E5E7EB" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#A8B3C5" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#364152" />
          <SolidColorBrush x:Key="AppControlBorderBrush" Color="#445064" />
          <SolidColorBrush x:Key="AppHoverBrush" Color="#2C3848" />
          <SolidColorBrush x:Key="AppSelectionBrush" Color="#4A2238" />
          <SolidColorBrush x:Key="AppDisabledSurfaceBrush" Color="#1B2430" />
          <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#8995A8" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#BE185D" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#DB2777" />
          <SolidColorBrush x:Key="AppAccentDisabledBrush" Color="#5B2340" />
          <SolidColorBrush x:Key="AppAccentTextBrush" Color="#F472B6" />
          <SolidColorBrush x:Key="MessageErrorBrush" Color="#452631" />
          <SolidColorBrush x:Key="MessageWarningBrush" Color="#3D3320" />
          <SolidColorBrush x:Key="MessageInfoBrush" Color="#1F3A31" />
          <SolidColorBrush x:Key="MessageErrorBorderBrush" Color="#6B2A35" />
          <SolidColorBrush x:Key="MessageWarningBorderBrush" Color="#5C4A1F" />
          <SolidColorBrush x:Key="MessageInfoBorderBrush" Color="#2F5A47" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="StatusNoticeBrush" Color="#FFB454" />
          <SolidColorBrush x:Key="StatusPositiveBrush" Color="#6CCB8F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- The palette tints what the app styles do not override (focus rings, check boxes, calendar). -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#BE185D" RegionColor="#F5F6F8" />
        <ColorPaletteResources x:Key="Dark" Accent="#DB2777" RegionColor="#141B25" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://EventPlanner/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
